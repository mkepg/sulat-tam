# ── Database ───────────────────────────────────────────────
DB_HOST=db
DB_USER=sulattam
DB_PASS=sulattam
DB_NAME=sulat_tam

# ── Auth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# Cookie flags. Production: true / None (cross-site over HTTPS).
# Local Docker: false / Lax (same-site over plain HTTP).
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ── Mail ───────────────────────────────────────────────────
# Defaults target the MailHog container. For real delivery, point these at
# your SMTP provider and set SMTP_USER/SMTP_PASS.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sulattam.local

# Public base URL used to build the email verification link.
APP_URL=http://localhost:8080

# ── CORS ───────────────────────────────────────────────────
# Comma-separated list of origins permitted to send credentialed requests.
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend ───────────────────────────────────────────────
VITE_API_URL=http://localhost:8080

# ── Image uploads ──────────────────────────────────────────
# Profile pictures are uploaded to ImgBB. Get a key at https://api.imgbb.com/
# Leave blank to disable image upload (the app degrades gracefully).
IMGBB_API_KEY=
